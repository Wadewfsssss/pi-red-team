{
  "name": "pi-red-team",
  "version": "1.0.0-rc.11",
  "private": true,
  "description": "Thin, expert-supervised red-team extension for Pi native tools, sessions and MCP",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wadewfsssss/pi-red-team.git"
  },
  "keywords": ["pi-package", "pi", "extension", "red-team"],
  "engines": { "node": ">=22.19.0" },
  "files": ["dist", "README.md", "THIRD_PARTY_NOTICES.md", "CHANGELOG.md"],
  "pi": { "extensions": ["./dist/thin/index.js"] },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "redteam-zod": "npm:zod@4.6.7"
  },
  "overrides": { "undici": "8.12.2" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.23.15",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
